<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Invoice / Move Form View with Analytic Account -->
    <record id="view_move_form_inherit_analytic" model="ir.ui.view">
        <field name="name">account.move.form.inherit.analytic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="havano_analytic_account_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Payment Form View with Analytic Account -->
    <record id="view_payment_form_inherit_analytic" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.analytic</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="havano_analytic_account_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
