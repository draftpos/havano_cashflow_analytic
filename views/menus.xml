<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Menu for Analytic Accounts under standard Accounting -> Configuration -->
    <menuitem 
        id="menu_accounting_analytic_accounts" 
        name="Analytic Accounts (Havano)" 
        parent="account.menu_finance_configuration" 
        action="action_havano_analytic_account" 
        sequence="40"/>

    <!-- Cash Flow by Analytic Account Client Action -->
    <record id="action_havano_cashflow_analytic_report" model="ir.actions.client">
        <field name="name">Cash Flow by Analytic Account</field>
        <field name="tag">havano_cashflow_analytic_report</field>
    </record>

    <!-- Report Menu Item under standard Accounting -> Reporting -->
    <menuitem 
        id="menu_accounts_cashflow_analytic" 
        name="Cash Flow by Analytic Account" 
        parent="account.menu_finance_reports" 
        action="action_havano_cashflow_analytic_report" 
        sequence="15"/>
</odoo>
